# Copia este archivo como .env y completa los valores (nunca subas .env a GitHub).
# Solo variables con prefijo EXPO_PUBLIC_ llegan a la app, y son visibles para cualquiera
# que descompile el APK: aquí solo van valores públicos.

# Supabase (Fase 3) — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NO pongas aquí claves de IA ni la service_role de Supabase.
# Esas viven como secretos de las Edge Functions: `supabase secrets set NOMBRE=valor`.
