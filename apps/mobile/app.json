{
  "expo": {
    "name": "Disciplina AI",
    "slug": "disciplina-ai",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "disciplina",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B14",
    "ios": {
      "bundleIdentifier": "com.fernanxd.disciplinaai",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.fernanxd.disciplinaai",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#22D3EE"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Disciplina AI usa la cámara para fotografiar tu comida y estimar sus calorías.",
          "photosPermission": "Disciplina AI usa tus fotos para analizar comidas que elijas.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
